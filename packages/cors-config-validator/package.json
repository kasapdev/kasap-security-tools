{
  "name": "@kasap/cors-config-validator",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "CLI + rule engine that audits a CORS configuration (live URL or config file) for common security misconfigurations.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
